# ===================== EIRA — Entrega segura de resultados =====================
# Copiar a .env y ajustar.

# Base de datos. Por defecto SQLite para ejecución inmediata.
# En producción con Postgres (docker-compose / RDS):
#   DATABASE_URL="postgresql://eira:CAMBIA@db:5432/eira"
#   y cambiar provider="sqlite" -> "postgresql" en prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Secreto para firmar el JWT de sesión (OBLIGATORIO cambiar en producción).
# Generar con: openssl rand -base64 32
JWT_SECRET="CAMBIA-ESTO-en-produccion"

# URL pública de la app: se usa para el link temporal dentro del SMS/QR.
# En EC2:  NEXT_PUBLIC_APP_URL="http://<ip-publica-ec2>:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Caché efímera (tokens, OTP, rate-limit). Sin esto -> fallback en memoria.
VALKEY_URL="redis://localhost:6379"

# Proveedor SMS: mock (simulado, default) | sns | twilio (interfaces preparadas)
SMS_PROVIDER="mock"

# Correo real opcional vía SMTP (nodemailer). Default desactivado.
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="resultados@eira.org.mx"

# Cookie segura solo por HTTPS en producción (1=activada, 0=desactivada)
COOKIE_SECURE="1"
